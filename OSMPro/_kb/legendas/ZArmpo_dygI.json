{"data": "2024-08-01", "tipo": "short", "titulo": "Few people know this advice! | OSM PRO", "duracao": "0:31", "visualizacoes": "3258", "link": "https://www.youtube.com/shorts/ZArmpo_dygI", "id": "ZArmpo_dygI", "canal": "osmproworld", "lingua": "pt-BR", "automatica": true, "linhas": [{"text": "Mantenha um equilíbrio de idades no", "start": 0.1, "duration": 2.68}, {"text": " seu elenco. Evite formar um time apenas", "start": 1.826, "duration": 4.996}, {"text": " com jogadores jovens ou, inversamente,", "start": 5.876, "duration": 3.06}, {"text": " com jogadores mais velhos. Garanta que,", "start": 7.99, "duration": 4.543}, {"text": " no seu time titular, você tenha pelo", "start": 11.596, "duration": 3.323}, {"text": " menos três jogadores com mais de 26", "start": 13.982, "duration": 3.26}, {"text": " anos. E não se esqueça, seu capitão", "start": 16.305, "duration": 5.629}, {"text": " deve ter mais de 30 anos. Essa mistura", "start": 21.005, "duration": 4.772}, {"text": " de juventude e experiência é", "start": 24.827, "duration": 2.498}, {"text": " essencial para um desempenho", "start": 26.375, "duration": 2.397}, {"text": " consistente e sólido ao longo da", "start": 27.822, "duration": 2.647}, {"text": " temporada.", "start": 29.519, "duration": 1.5}]}